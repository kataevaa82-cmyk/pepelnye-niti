; Godot 4.4.1, GDScript, Compatibility / single-threaded Web.
config_version=5

[application]
config/name="Пепельные нити"
config/description="Разрушь преграды. Собери свет. Вернись живым."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]
Platform="*res://scripts/platform.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.045, 0.055, 0.057, 1)
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=16.0
